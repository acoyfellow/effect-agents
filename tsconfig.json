{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["@cloudflare/workers-types", "bun-types"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["examples/**/*.ts", "src/**/*.ts", "worker/worker.ts", "probes/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "worker/alchemy.run.ts"]
}
